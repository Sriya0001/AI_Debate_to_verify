# ── FC-MAD Multi-Agent Fact Verification Configuration ───────────────────────

# LLM Provider selection: "groq" (Recommended Free Tier) | "ollama" (Free Local) | "anthropic" | "openai" | "mock"
LLM_PROVIDER=groq

# ── 100% Free Tier API Keys (No Credit Card Required) ─────────────────────────
# 1. Groq (Free LLM inference for Llama 3.3 70B & Llama 3.1 8B): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# 2. Tavily (Free Live Web Search - 1,000 queries/month): https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── Optional Paid Frontier Providers ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection by Agent Tier
CLAIM_ANALYZER_MODEL=claude-haiku-4-5-20251001
PLANNER_MODEL=claude-haiku-4-5-20251001
SOURCE_CREDIBILITY_MODEL=claude-haiku-4-5-20251001
ADVOCATE_MODEL=claude-haiku-4-5-20251001
SKEPTIC_MODEL=claude-haiku-4-5-20251001
NEUTRAL_MODEL=claude-haiku-4-5-20251001
CRITIC_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-sonnet-4-6
FINAL_VERIFIER_MODEL=claude-sonnet-4-6

# ── Cross-Model Heterogeneous Super-Debate Roster ─────────────────────────────
# Assign distinct model architectures across Debater 0, Debater 1, Debater 2
# Option 1 (All Free via Groq): Llama 3.3 70B (Meta) + Gemma 2 9B (Google) + Mixtral 8x7B (Mistral)
DEBATER_MODELS=llama-3.3-70b-versatile,gemma2-9b-it,mixtral-8x7b-32768

# Option 2 (Cross-Provider):
# DEBATER_MODELS=groq/llama-3.3-70b-versatile,anthropic/claude-haiku-4-5-20251001,openai/gpt-4o-mini

# Thresholds
MAX_DEBATE_ROUNDS=3
MAX_RESEARCH_ROUNDS=2
MIN_EVIDENCE_COUNT=3
CONFLICT_THRESHOLD=0.35
LOW_CONFIDENCE_THRESHOLD=0.55
SOURCE_CREDIBILITY_THRESHOLD=0.60

# Database
DATABASE_URL=sqlite:///veritas.db
