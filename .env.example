# ── VERITAS AI Environment Configuration ────────────────────────────────────

# LLM Provider selection: "anthropic" | "openai" | "mock"
LLM_PROVIDER=anthropic

# API Keys (leave blank to run in offline / benchmark mock mode)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Model Selection by Agent Tier
CLAIM_ANALYZER_MODEL=claude-haiku-4-5-20251001
PLANNER_MODEL=claude-haiku-4-5-20251001
SOURCE_CREDIBILITY_MODEL=claude-haiku-4-5-20251001
ADVOCATE_MODEL=claude-haiku-4-5-20251001
SKEPTIC_MODEL=claude-haiku-4-5-20251001
NEUTRAL_MODEL=claude-haiku-4-5-20251001
CRITIC_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-sonnet-4-6
FINAL_VERIFIER_MODEL=claude-sonnet-4-6

# Thresholds
MAX_DEBATE_ROUNDS=3
MAX_RESEARCH_ROUNDS=2
MIN_EVIDENCE_COUNT=3
CONFLICT_THRESHOLD=0.35
LOW_CONFIDENCE_THRESHOLD=0.55
SOURCE_CREDIBILITY_THRESHOLD=0.60

# Database
DATABASE_URL=sqlite:///veritas.db
